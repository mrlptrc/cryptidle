generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 character Character?
}
model Session {
 id String @id
 expiresAt DateTime
 token String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
}
model Character {
 id String @id @default(uuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 name String @unique
 classId String
 gold Int @default(0)
 xp Int @default(0)
 level Int @default(1)
 data Json
 roomId String?
 items Item[]
 @@index([level,xp])
}
model Item {
 id String @id @default(uuid())
 definitionId String
 ownerId String
 owner Character @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 equipped Boolean @default(false)
 listed Boolean @default(false)
 listing MarketListing?
 @@index([ownerId])
}
model MarketListing {
 id String @id @default(uuid())
 itemId String @unique
 item Item @relation(fields:[itemId],references:[id],onDelete:Restrict)
 sellerId String
 price Int
 createdAt DateTime @default(now())
}
model Audit {
 id String @id @default(uuid())
 kind String
 actorId String
 data Json
 createdAt DateTime @default(now())
}
model Idempotency {
 userId String
 key String
 hash String
 response Json
 createdAt DateTime @default(now())
 @@id([userId,key])
}
model BossRoom {
 id String @id @default(uuid())
 code String @unique
 data Json
}
model BossReward {
 roomId String
 characterId String
 createdAt DateTime @default(now())
 @@id([roomId,characterId])
}
model ChatMessage {
 id String @id @default(uuid())
 characterId String
 name String
 text String
 createdAt DateTime @default(now())
 @@index([createdAt])
}
