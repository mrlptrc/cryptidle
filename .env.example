BETTER_AUTH_SECRET=example-local-only-change-this-to-random-32-plus-characters
DATABASE_URL=postgresql://cryptidle:example-local-only-change-me@localhost:5432/cryptidle
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
OFFLINE_CAP_HOURS=8
BOSS_COOLDOWN_MINUTES=15
